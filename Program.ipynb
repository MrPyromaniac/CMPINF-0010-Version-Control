    "food = input(\"Whats your favorite food: \")\n",
    "foodNum = 0\n",
    "show = input(\"Whats your favorite show: \")\n",
    "showNum = 0\n",
    "\n",
    "for char in food:\n",
    "    foodNum += 1\n",
    "\n",
    "for char in show:\n",
    "    showNum += 1\n",
    "\n",
    "print(\"The total number of letters in those words is\", foodNum + showNum)"
